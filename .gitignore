__pycache__/
*.pyc
.DS_Store

# Etat et session de la synchro Supabase : contient les jetons d'auth, ne doit
# jamais partir dans git. Et ce sont des fichiers de machine, pas du contenu.
.obsidian/plugins/supabase-vault-sync/data.json
.obsidian/plugins/obsidian-supabase-sync/sync-metadata.json
.obsidian/plugins/obsidian-supabase-sync/sync-queue.json

# Copies laissees par les conflits de synchro : du bruit, pas du contenu.
notes/conflicts/

# Journaux et snapshots des passages horaires de /eco : machine, pas contenu.
# (etat.json est suivi, lui : c'est la memoire des passages.)
.claude/skills/eco/passages.log
.claude/skills/eco/launchd.log
.claude/skills/eco/scratch/
.claude/skills/eco/.verrou/

# Sources brutes deposees a cote des fiches (photos de cahier, PDF de slides) :
# elles restent sur le disque, elles ne partent pas sur GitHub.
eco gestion/fichier/

# Notes d'amphi prises par des camarades (dossiers `drive-download-*`) : elles
# appartiennent a leurs auteurs. Le depot est public, elles restent locales.
# Ce qui se publie, c'est la fiche que Sacha revise, pas la copie de leur cours.
eco gestion/_brut/drive-download-*/
eco gestion/_brut/**/*.docx
eco gestion/_brut/camarade - *.md
.claude/skills/notes/passages.log
.claude/skills/notes/launchd.log
.claude/skills/notes/scratch/
.claude/skills/notes/.verrou/
.claude/skills/notes/etat-debut.json
